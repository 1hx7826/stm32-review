{
  "name": "stm32-review-prototype",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "content": "node scripts/prepare-content.mjs",
    "dev": "npm run content && vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "npm run content && tsc -b && vite build && node scripts/audit-public.mjs --finalize && node scripts/audit-dist.mjs",
    "test": "npm run content && vitest run",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "typecheck": "npm run content && tsc --noEmit"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/cli": "0.1.22",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "fake-indexeddb": "6.2.5",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
